    <cl:model std:sid="model-5b2b82fd"/>
    <cl:appspec title="프리폼 타이틀">
      <cl:property name="title" type="string" default="제목없음" bindable="true" std:desc="제목(ctrl이 지정된 경우, ctrl 컨트롤의 fieldLabel로 대체됨)"/>
