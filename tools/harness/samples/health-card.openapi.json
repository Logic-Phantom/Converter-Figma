{
  "openapi": "3.0.3",
  "info": {
    "title": "보건소 등록카드 API",
    "version": "1.0.0",
    "description": "tools/harness 샘플. clx-src/json/2025-08-04/2025-08-04_e69f5327.json (우리보건소 등록카드 화면)에 맞춘 가상의 백엔드."
  },
  "servers": [ { "url": "/api/v1" } ],
  "paths": {
    "/health-cards": {
      "get": {
        "operationId": "listHealthCards",
        "summary": "등록카드 목록 조회",
        "tags": [ "health-card" ],
        "parameters": [
          { "name": "budgetYear", "in": "query", "description": "예산연도", "schema": { "type": "string" } },
          { "name": "targetType", "in": "query", "description": "대상자 구분 코드", "schema": { "type": "string", "enum": [ "ALL", "ADULT_HI", "ADULT_MA", "CHILD_MA", "CHILD_HI" ] } },
          { "name": "name", "in": "query", "schema": { "type": "string" } },
          { "name": "rrn", "in": "query", "description": "주민등록번호", "schema": { "type": "string" } },
          { "name": "withdrawYn", "in": "query", "schema": { "type": "string" } },
          { "name": "directorDelegateYn", "in": "query", "description": "보건소장 위임 여부", "schema": { "type": "string" } },
          { "name": "pageNo", "in": "query", "schema": { "type": "integer" } },
          { "name": "pageSize", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "string" },
                    "message": { "type": "string" },
                    "data": {
                      "type": "object",
                      "properties": {
                        "total": { "type": "integer" },
                        "list": { "type": "array", "items": { "$ref": "#/components/schemas/HealthCard" } }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createHealthCard",
        "summary": "등록카드 등록",
        "tags": [ "health-card" ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HealthCardSave" } } } },
        "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResult" } } } } }
      }
    },
    "/health-cards/{cardNo}": {
      "get": {
        "operationId": "getHealthCard",
        "summary": "등록카드 상세",
        "tags": [ "health-card" ],
        "parameters": [ { "name": "cardNo", "in": "path", "required": true, "schema": { "type": "string" } } ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "code": { "type": "string" }, "data": { "$ref": "#/components/schemas/HealthCard" } }
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteHealthCard",
        "summary": "등록카드 삭제",
        "tags": [ "health-card" ],
        "parameters": [ { "name": "cardNo", "in": "path", "required": true, "schema": { "type": "string" } } ],
        "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiResult" } } } } }
      }
    },
    "/codes/{group}": {
      "get": {
        "operationId": "listCodes",
        "summary": "공통코드 목록",
        "tags": [ "code" ],
        "parameters": [ { "name": "group", "in": "path", "required": true, "schema": { "type": "string" } } ],
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "type": "array", "items": { "type": "object", "properties": { "code": { "type": "string" }, "codeName": { "type": "string" } } } } } }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiResult": {
        "type": "object",
        "properties": { "code": { "type": "string" }, "message": { "type": "string" } }
      },
      "HealthCardBase": {
        "type": "object",
        "properties": {
          "cardNo": { "type": "string", "description": "등록카드 번호" },
          "budgetYear": { "type": "string", "description": "예산연도" },
          "name": { "type": "string" },
          "rrn": { "type": "string", "description": "주민등록번호" },
          "regNo": { "type": "string" },
          "diseaseCode": { "type": "string", "description": "상병코드" },
          "targetType": { "type": "string", "description": "대상자 구분" },
          "directorDelegateYn": { "type": "string", "description": "보건소장 위임여부" },
          "withdrawYn": { "type": "string", "description": "퇴록 여부" }
        }
      },
      "HealthCard": {
        "allOf": [
          { "$ref": "#/components/schemas/HealthCardBase" },
          {
            "type": "object",
            "properties": {
              "regDate": { "type": "string", "format": "date" },
              "inputDate": { "type": "string", "format": "date", "description": "전산 입력일" },
              "applyDocYn": { "type": "string", "description": "지원신청서 제출 여부" },
              "otherYearRegYn": { "type": "string", "description": "다른연도 등록" },
              "amount": { "type": "number", "format": "double", "description": "지원금액" },
              "visitCount": { "type": "integer" }
            }
          }
        ]
      },
      "HealthCardSave": {
        "allOf": [
          { "$ref": "#/components/schemas/HealthCardBase" },
          { "type": "object", "properties": { "memo": { "type": "string", "description": "비고" } } }
        ]
      }
    }
  }
}
