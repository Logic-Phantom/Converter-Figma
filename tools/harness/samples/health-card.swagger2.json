{
  "swagger": "2.0",
  "info": { "title": "보건소 등록카드 API (Swagger 2.0)", "version": "1.0.0" },
  "basePath": "/api/v1",
  "paths": {
    "/health-cards": {
      "get": {
        "operationId": "listHealthCards",
        "summary": "등록카드 목록 조회",
        "parameters": [
          { "name": "budgetYear", "in": "query", "type": "string", "description": "예산연도" },
          { "name": "name", "in": "query", "type": "string", "description": "성명" },
          { "name": "rrn", "in": "query", "type": "string", "description": "주민등록번호" },
          { "name": "regDateFrom", "in": "query", "type": "string", "description": "등록일 시작" },
          { "name": "regDateTo", "in": "query", "type": "string", "description": "등록일 종료" }
        ],
        "responses": { "200": { "description": "OK", "schema": { "type": "array", "items": { "$ref": "#/definitions/HealthCard" } } } }
      },
      "post": {
        "operationId": "saveHealthCards",
        "summary": "등록카드 일괄 저장",
        "parameters": [ { "name": "body", "in": "body", "schema": { "type": "array", "items": { "$ref": "#/definitions/HealthCard" } } } ],
        "responses": { "200": { "description": "OK" } }
      }
    }
  },
  "definitions": {
    "HealthCard": {
      "type": "object",
      "properties": {
        "cardNo": { "type": "string" },
        "budgetYear": { "type": "string", "description": "예산연도" },
        "name": { "type": "string", "description": "성명" },
        "rrn": { "type": "string", "description": "주민등록번호" },
        "regNo": { "type": "string", "description": "등록번호" },
        "diseaseCode": { "type": "string", "description": "상병코드" },
        "targetType": { "type": "string", "description": "대상자 구분" },
        "regDate": { "type": "string", "description": "등록일" },
        "withdrawYn": { "type": "string", "description": "퇴록" }
      }
    }
  }
}
